    <!-- Cinema Sessions for Hall 1 -->
    <record id="session_h1_1" model="cinema.session">
        <field name="name">Morning Show - Avatar 3</field>
        <field name="movie_name">Avatar 3</field>
        <field name="hall_id" ref="cinema_hall_1"/>
        <field name="start_time" eval="(datetime.now() + timedelta(days=1)).replace(hour=10, minute=0)"/>
        <field name="end_time" eval="(datetime.now() + timedelta(days=1)).replace(hour=13, minute=0)"/>
        <field name="price">150.0</field>
    </record>

