<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cinema_booking_form" model="ir.ui.view">
        <field name="name">cinema.booking.form</field>
        <field name="model">cinema.booking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="session_id"/>
                        <field name="seat_id"/>
                        <field name="customer_name"/>
                        <field name="customer_phone"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cinema_booking_list" model="ir.ui.view">
        <field name="name">cinema.booking.list</field>
        <field name="model">cinema.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="session_id"/>
                <field name="seat_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_cinema_booking" model="ir.actions.act_window">
        <field name="name">Cinema Bookings</field>
        <field name="res_model">cinema.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
