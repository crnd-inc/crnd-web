<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="development_stage_view_form" model="ir.ui.view">
        <field name="model">development.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type_id"/>
                        <field name="development_type_id"/>
                        <field name="route_in_ids" widget="many2many_tags"/>
                        <field name="route_out_ids" widget="many2many_tags"/>
                        <field name="development_ids" widget="many2many_tags"/>
                        <field name="use_custom_colors"/>
                    </group>
                    <group invisible="use_custom_colors == True">
                        <field name="res_bg_color" widget="color"/>
                        <field name="res_label_color" widget="color"/>
                    </group>
                    <group invisible="use_custom_colors == False">
                        <field name="bg_color" widget="color"/>
                        <field name="label_color" widget="color"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="development_stage_tree_view" model="ir.ui.view">
        <field name="model">development.stage</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="type_id"/>
            </tree>
        </field>
    </record>

    <record id="development_stage_action" model="ir.actions.act_window">
        <field name="name">Development Stage</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">development.stage</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="development_stage_menu"
              sequence="2"
              name="Development Stages"
              parent="developments_menu_root"
              action="development_stage_action"/>

</odoo>
