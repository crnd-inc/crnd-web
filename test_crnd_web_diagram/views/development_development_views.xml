<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="development_view_form" model="ir.ui.view">
        <field name="model">development.development</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_development_development_diagram"
                                type="object"
                                string="View Flow"
                                class="oe_stat_button"
                                icon="fa-code-fork">
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="development_type_id"/>
                        <field name="development_stage_id" domain="[('development_type_id', '=', development_type_id)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="development_tree_view" model="ir.ui.view">
        <field name="model">development.development</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="development_type_id"/>
                <field name="development_stage_id"/>
            </tree>
        </field>
    </record>

    <record id="development_action" model="ir.actions.act_window">
        <field name="name">development</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">development.development</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.ui.view" id="view_development_development_diagram">
        <field name="model">development.development</field>
        <field name="type">diagram_plus</field>
        <field name="arch" type="xml">
            <diagram_plus auto_layout="false">
                <node object="development.stage"
                      bgcolor="gray:closed"
                      bg_color_field="res_bg_color"
                      fg_color_field="res_label_color"
                      d_position_field="diagram_position">
                </node>
                <arrow object="development.stage.route"
                       source="stage_from_id"
                       destination="stage_to_id"
                       label="['name']">
                </arrow>
            </diagram_plus>
        </field>
    </record>

    <menuitem name="Developments"
              id="developments_menu_root"
              sequence="1"/>

    <menuitem id="developments_menu"
              sequence="1"
              name="Developments"
              parent="developments_menu_root"
              action="development_action"/>

</odoo>
