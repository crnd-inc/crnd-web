<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Controller Template -->
    <t t-name="yodoo_plan_view.Controller">
        <Layout display="props.display" className="'o_plan_view'">
            <PlanRenderer model="model" resModel="props.resModel" resId="props.resId" onMounted.bind="onRendererMounted" onSelectionChange.bind="onSelectionChange"/>
        </Layout>
    </t>

    <!-- Renderer Template -->
    <t t-name="yodoo_plan_view.Renderer">
        <div class="o_plan_view_renderer" style="display: flex; height: 100%; position: relative;">
            
            <!-- Zoom Controls (top-right, for everyone) -->
            <div class="o_plan_zoom_controls" style="position: absolute; top: 10px; right: 10px; z-index: 1000;">
                <div class="btn-group-vertical">
                    <button class="btn btn-sm btn-light" t-on-click="() => this.zoomIn()" title="Zoom In (Ctrl + Scroll Up)">
                        <i class="fa fa-plus"/>
                    </button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.zoomOut()" title="Zoom Out (Ctrl + Scroll Down)">
                        <i class="fa fa-minus"/>
                    </button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.resetZoom()" title="Reset Zoom">
                        <i class="fa fa-crosshairs"/>
                    </button>
                </div>
            </div>
            
            <t t-if="state.loading">
                <div class="text-center p-5">
                    <i class="fa fa-spinner fa-spin fa-3x"/>
                    <p class="mt-3">Завантаження плану...</p>
                </div>
            </t>
            <t t-else="">
                <t t-if="hasImage">
                    <!-- Sidebar with objects list or booking interface -->
                    <div class="o_plan_sidebar" t-att-style="'width: ' + (state.sidebarVisible ? '300px' : '0') + '; border-right: 1px solid #dee2e6; overflow-y: auto; background: white; transition: width 0.3s ease;' + (state.sidebarVisible ? '' : ' overflow: hidden;')">
                        <div class="p-3">
                            <!-- Booking Mode Interface -->
                            <t t-if="state.bookingMode">
                                <div class="alert alert-info mb-3">
                                    <h6 class="mb-1"><i class="fa fa-ticket"/> Бронювання</h6>
                                    <small t-if="props.model.bookingConfig" t-esc="props.model.bookingConfig.sessionName"/>
                                </div>
                                
                                <!-- Selected objects -->
                                <h6 class="mb-2">Вибрані (<t t-esc="state.selectedBookingObjects.length"/>)</h6>
                                <t t-if="state.selectedBookingObjects.length > 0">
                                    <div class="list-group mb-3" style="max-height: 200px; overflow-y: auto;">
                                        <t t-foreach="getSelectedBookingInfo()" t-as="obj" t-key="obj.id">
                                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                                <span><i class="fa fa-ticket text-warning"/> <t t-esc="obj.name"/></span>
                                                <button class="btn btn-sm btn-link text-danger p-0" 
                                                        t-on-click="() => this.toggleBookingSelection({relatedId: obj.id})"
                                                        title="Прибрати">
                                                    <i class="fa fa-times"/>
                                                </button>
                                            </div>
                                        </t>
                                    </div>
                                    
                                    <!-- Customer name input -->
                                    <div class="mb-3">
                                        <label class="form-label small">Ім'я клієнта:</label>
                                        <input type="text" 
                                               class="form-control form-control-sm" 
                                               t-model="state.bookingCustomerName"
                                               placeholder="Введіть ім'я"/>
                                    </div>
                                    
                                    <!-- Action buttons -->
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-success btn-sm flex-fill" 
                                                t-on-click="() => this.createBookings()"
                                                t-att-disabled="!state.bookingCustomerName.trim()">
                                            <i class="fa fa-check"/> Бронювати (<t t-esc="state.selectedBookingObjects.length"/>)
                                        </button>
                                        <button class="btn btn-secondary btn-sm" 
                                                t-on-click="() => this.clearBookingSelection()">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-secondary small">
                                        <i class="fa fa-info-circle"/> Клікніть на місця на плані щоб вибрати їх
                                    </div>
                                </t>
                                
                                <!-- Legend -->
                                <div class="mt-3 pt-3 border-top">
                                    <h6 class="small mb-2">Легенда:</h6>
                                    <div class="d-flex flex-column gap-1 small">
                                        <div class="d-flex align-items-center gap-2">
                                            <div style="width: 16px; height: 16px; background: #27ae60; border: 1px solid #229954;"></div>
                                            <span>Вільне</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <div style="width: 16px; height: 16px; background: #f39c12; border: 1px solid #e67e22;"></div>
                                            <span>Вибране</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <div style="width: 16px; height: 16px; background: #e74c3c; border: 1px solid #c0392b;"></div>
                                            <span>Заброньоване</span>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            
                            <!-- Normal Mode - Objects List -->
                            <t t-else="">
                                <h5 class="mb-3">
                                    <i class="fa fa-list"/> Об'єкти
                                </h5>
                                <t t-if="state.data.relatedObjects and state.data.relatedObjects.length > 0">
                                    <div class="list-group">
                                        <t t-foreach="state.data.relatedObjects" t-as="obj" t-key="obj.id">
                                            <a href="#" 
                                               t-att-class="'list-group-item list-group-item-action ' + (state.selectedObjectId === obj.id ? 'active' : '')"
                                               t-on-click.prevent="() => this.onObjectClick(obj)"
                                               t-on-dblclick.prevent="() => this.onObjectDblClick(obj)">
                                                <div class="d-flex w-100 justify-content-between align-items-baseline">
                                                    <h6 class="mb-0" t-esc="obj.name"/>
                                                    <small t-if="obj.roomNumber" class="text-muted" t-esc="obj.roomNumber"/>
                                                </div>
                                                <small t-if="obj.roomType" class="text-muted" t-esc="obj.roomType"/>
                                            </a>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-info">
                                        <i class="fa fa-info-circle"/> Немає об'єктів
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                    
                    <!-- Canvas з зображенням плану -->
                    <div class="o_plan_canvas_container" 
                         style="flex: 1; height: calc(100vh - 150px); position: relative; overflow: auto; background: #f0f0f0;"
                         t-on-wheel="onWheel"
                         t-on-mousedown="onCanvasMouseDown"
                         t-on-mousemove="onCanvasMouseMove"
                         t-on-mouseup="onCanvasMouseUp"
                         t-on-mouseleave="onCanvasMouseLeave">
                        
                        <!-- Edit Controls шар над canvas (hidden in booking mode) -->
                        <div t-if="!state.bookingMode" class="o_plan_edit_controls" style="position: sticky; top: 10px; left: 10px; z-index: 998; display: inline-flex; gap: 8px; pointer-events: auto; width: auto;">
                            <div class="btn-group">
                                <button t-att-class="'btn btn-sm ' + (state.editModeEnabled ? 'btn-warning' : 'btn-secondary')" 
                                        t-on-click="() => this.toggleEditMode()" 
                                        title="Toggle Edit Mode">
                                    <i t-att-class="'fa ' + (state.editModeEnabled ? 'fa-unlock' : 'fa-lock')"/>
                                    <t t-esc="state.editModeEnabled ? ' Edit' : ' View'"/>
                                </button>
                            </div>
                            
                            <div class="btn-group" t-if="state.editModeEnabled">
                                <button t-att-class="'btn btn-sm ' + (state.drawMode ? 'btn-success' : 'btn-secondary')" 
                                        t-on-click="() => this.startDrawMode()" 
                                        title="Draw Polygon (Ctrl+D)">
                                    <i class="fa fa-pencil"/>
                                    Draw
                                </button>
                            </div>
                            
                            <div class="btn-group" t-if="state.editModeEnabled and !state.editingPolygonId">
                                <button class="btn btn-sm btn-secondary" 
                                        t-att-disabled="!state.selectedPolygonId"
                                        t-on-click="() => this.startEditPolygon(state.data.polygons.find(p => p.id === state.selectedPolygonId))" 
                                        title="Edit Selected Polygon">
                                    <i class="fa fa-edit"/>
                                </button>
                                <button class="btn btn-sm btn-info" 
                                        t-att-disabled="!state.selectedPolygonId"
                                        t-on-click="() => this.attachObjectToPolygon()" 
                                        title="Attach Object to Polygon">
                                    <i class="fa fa-link"/>
                                </button>
                                <button class="btn btn-sm btn-danger" 
                                        t-att-disabled="!state.selectedPolygonId"
                                        t-on-click="() => this.deletePolygon()" 
                                        title="Delete Selected Polygon (Del)">
                                    <i class="fa fa-trash"/>
                                </button>
                            </div>
                            
                            <div class="btn-group" t-if="state.editingPolygonId">
                                <button class="btn btn-sm btn-success" 
                                        t-on-click="() => this.saveEditedPolygon()" 
                                        title="Save Changes">
                                    <i class="fa fa-check"/>
                                    Save
                                </button>
                                <button class="btn btn-sm btn-secondary" 
                                        t-on-click="() => this.cancelEdit()" 
                                        title="Cancel Editing">
                                    <i class="fa fa-times"/>
                                    Cancel
                                </button>
                            </div>
                        </div>
                        
                        <!-- Sidebar Toggle Button шар над canvas -->
                        <button class="btn btn-sm btn-light o_plan_sidebar_toggle" 
                                style="position: sticky; top: 60px; left: 10px; z-index: 999; pointer-events: auto;"
                                t-on-click="() => this.toggleSidebar()" 
                                t-att-title="state.sidebarVisible ? 'Сховати панель' : 'Показати панель'">
                            <i t-att-class="'fa ' + (state.sidebarVisible ? 'fa-chevron-left' : 'fa-chevron-right')"/>
                        </button>
                        
                        <div class="o_plan_canvas_wrapper" 
                             t-att-style="'transform: scale(' + state.zoom + '); transform-origin: 0 0; position: absolute; top: 0; left: 0;'">
                            <!-- Background image -->
                            <img t-att-src="imageUrl" 
                                 style="display: block; width: auto; height: auto; user-select: none;"
                                 draggable="false"
                                 t-on-load="onImageLoad"
                                 t-on-dragstart="onImageDragStart"/>
                            
                            <!-- SVG overlay for polygons -->
                            <svg class="o_plan_svg_overlay"
                                 t-if="state.imageWidth > 0"
                                 t-att-width="state.imageWidth"
                                 t-att-height="state.imageHeight"
                                 t-att-style="'position: absolute; top: 0; left: 0; ' + ((state.currentTool === 'draw' || state.editingPolygonId) ? 'pointer-events: all; ' : 'pointer-events: none; ') + (state.currentTool === 'draw' ? 'cursor: crosshair;' : state.editingPolygonId ? 'cursor: default;' : '')"
                                 t-on-click="onSvgClick"
                                 t-on-dblclick="onSvgDblClick"
                                 t-on-contextmenu="onSvgContextMenu"
                                 t-on-mousemove="(ev) => { this.onSvgMouseMove(ev); this.onLabelMouseMove(ev); }"
                                 t-on-mouseup="(ev) => { this.onSvgMouseUp(ev); this.onLabelMouseUp(ev); }">
                                
                                <!-- Render existing polygons -->
                                <t t-foreach="state.data.polygons || []" t-as="polygon" t-key="polygon.id">
                                    <t t-set="polyStyle" t-value="getPolygonStyle(polygon)"/>
                                    <polygon t-att-points="getPolygonPoints(polygon)"
                                             t-att-fill="polyStyle.fillColor"
                                             t-att-stroke="polyStyle.strokeColor"
                                             t-att-stroke-width="polyStyle.strokeWidth"
                                             t-att-opacity="polyStyle.opacity"
                                             style="pointer-events: all; cursor: pointer; transition: all 0.2s;"
                                             t-on-mouseenter="() => this.onPolygonMouseEnter(polygon)"
                                             t-on-mouseleave="() => this.onPolygonMouseLeave(polygon)"
                                             t-on-click="(ev) => this.onPolygonClick(polygon, ev)"
                                             t-on-dblclick="(ev) => this.onPolygonDblClick(polygon, ev)"/>
                                    
                                    <!-- Polygon label with drag handle -->
                                    <t t-if="polygon.points and polygon.points.length > 0">
                                        <t t-set="labelX" t-value="polygon.labelX != null and polygon.labelX !== 0 ? polygon.labelX : (polygon.centroidX != null and polygon.centroidX !== 0 ? polygon.centroidX : (polygon.points[0][0] != null ? polygon.points[0][0] : polygon.points[0].x))"/>
                                        <t t-set="labelY" t-value="polygon.labelY != null and polygon.labelY !== 0 ? polygon.labelY : (polygon.centroidY != null and polygon.centroidY !== 0 ? polygon.centroidY : (polygon.points[0][1] != null ? polygon.points[0][1] : polygon.points[0].y))"/>
                                        
                                        <!-- Label point: always visible in edit mode -->
                                        <circle t-if="state.editModeEnabled"
                                                t-att-cx="labelX"
                                                t-att-cy="labelY"
                                                r="6"
                                                fill="#ff9800"
                                                stroke="#fff"
                                                stroke-width="2"
                                                t-att-style="state.editingPolygonId === polygon.id ? 'pointer-events: all; cursor: move;' : 'pointer-events: none;'"
                                                t-on-mousedown="state.editingPolygonId === polygon.id ? (ev) => this.onLabelMouseDown(polygon, ev) : null"/>
                                        
                                        <!-- Label text: always visible in view mode, hidden when editing this polygon -->
                                        <text t-if="state.editingPolygonId !== polygon.id and polygon.labelText"
                                              t-att-x="labelX"
                                              t-att-y="labelY"
                                              text-anchor="middle"
                                              dominant-baseline="middle"
                                              style="fill: #000; font-size: 14px; font-weight: bold; pointer-events: none; text-shadow: 1px 1px 2px rgba(255,255,255,0.8);"
                                              t-esc="polygon.labelText"/>
                                    </t>
                                </t>
                                
                                <!-- Render temporary polygons -->
                                <t t-foreach="state.tempPolygons || []" t-as="tempPoly" t-key="tempPoly.id">
                                    <polygon t-att-points="getPolygonPoints(tempPoly)"
                                             t-att-fill="tempPoly.fillColor"
                                             t-att-stroke="tempPoly.strokeColor"
                                             t-att-stroke-width="tempPoly.strokeWidth"
                                             t-att-opacity="tempPoly.opacity"
                                             style="pointer-events: none;"/>
                                </t>
                                
                                <!-- Render current polygon being drawn -->
                                <t t-if="state.currentPolygon.length > 0">
                                    <polyline t-att-points="getPolygonPoints({points: state.currentPolygon})"
                                              fill="none"
                                              stroke="#e74c3c"
                                              stroke-width="2"
                                              style="pointer-events: none;"/>
                                    
                                    <!-- Draw points -->
                                    <t t-foreach="state.currentPolygon" t-as="point" t-key="point_index">
                                        <circle t-att-cx="point.x"
                                                t-att-cy="point.y"
                                                r="4"
                                                fill="#e74c3c"
                                                stroke="#fff"
                                                stroke-width="2"
                                                style="pointer-events: none;"/>
                                    </t>
                                </t>
                                
                                <!-- Render editing polygon (without points) -->
                                <t t-if="state.editingPolygonId and state.editingPoints.length > 0">
                                    <polygon t-att-points="getPolygonPoints({points: state.editingPoints})"
                                             fill="#3498db"
                                             stroke="#e74c3c"
                                             stroke-width="3"
                                             opacity="0.6"
                                             style="pointer-events: none;"/>
                                </t>
                                
                                <!-- Draggable points - LAST to be on top -->
                                <t t-if="state.editingPolygonId and state.editingPoints.length > 0">
                                    <t t-foreach="state.editingPoints" t-as="point" t-key="point_index">
                                        <circle t-att-cx="point.x"
                                                t-att-cy="point.y"
                                                r="6"
                                                t-att-fill="state.draggedPointIndex === point_index ? '#f39c12' : '#e74c3c'"
                                                stroke="#fff"
                                                stroke-width="2"
                                                style="pointer-events: all; cursor: move;"
                                                t-on-mousedown="(ev) => this.onPointMouseDown(point_index, ev)"/>
                                    </t>
                                </t>
                            </svg>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <!-- Повідомлення якщо немає зображення -->
                    <div class="alert alert-warning m-3">
                        <h4><i class="fa fa-exclamation-triangle"/> Зображення плану відсутнє</h4>
                        <p>Щоб використовувати Plan View, завантажте зображення плану поверху:</p>
                        <ol>
                            <li>Натисніть кнопку <strong>"Edit"</strong> вгорі</li>
                            <li>Перейдіть на вкладку <strong>"Plan"</strong></li>
                            <li>Завантажте зображення в поле <strong>"Plan Image"</strong></li>
                            <li>Збережіть та поверніться до Plan View</li>
                        </ol>
                        <p class="mb-0"><strong>Model:</strong> <t t-esc="props.resModel"/> | <strong>ID:</strong> <t t-esc="props.resId"/></p>
                    </div>
                </t>
            </t>
            
            <!-- Attach Object Dialog -->
            <div t-if="state.showAttachDialog" class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="fa fa-link"/> Прив'язати об'єкт до полігона
                            </h5>
                            <button type="button" class="btn-close" t-on-click="() => this.cancelAttach()"/>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted mb-3">
                                Оберіть об'єкт для прив'язки до вибраного полігона:
                            </p>
                            <div class="list-group">
                                <t t-foreach="state.data.relatedObjects" t-as="obj" t-key="obj.id">
                                    <button type="button" 
                                            class="list-group-item list-group-item-action"
                                            t-on-click="() => this.attachObject(obj.id)">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1" t-esc="obj.name"/>
                                            <small t-if="obj.roomNumber" t-esc="obj.roomNumber"/>
                                        </div>
                                        <small t-if="obj.roomType" class="text-muted" t-esc="obj.roomType"/>
                                    </button>
                                </t>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-warning" t-on-click="() => this.attachObject(null)">
                                <i class="fa fa-unlink"/> Відв'язати
                            </button>
                            <button type="button" class="btn btn-secondary" t-on-click="() => this.cancelAttach()">
                                <i class="fa fa-times"/> Скасувати
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Canvas Template -->
    <t t-name="yodoo_plan_view.Canvas">
        <div class="o_plan_canvas" t-ref="canvas">
            
            <!-- Toolbar -->
            <PlanToolbar t-if="props.editMode"
                editMode="props.editMode"
                selectedTool="props.selectedTool"
                onToolSelect.bind="props.onToolSelect"
                onSave.bind="save"
                onCancel.bind="cancel"
                onToggleGrid.bind="toggleGrid"
                onToggleSnap.bind="toggleSnapToGrid"/>
            
            <!-- Zoom Controls -->
            <PlanZoom 
                zoom="state.zoom"
                onZoomIn.bind="zoomIn"
                onZoomOut.bind="zoomOut"
                onZoomReset.bind="resetZoom"/>
            
            <!-- SVG Canvas -->
            <svg t-ref="svg" class="o_plan_svg"
                 t-att-width="state.imageWidth"
                 t-att-height="state.imageHeight"
                 t-att-viewBox="`0 0 ${state.imageWidth} ${state.imageHeight}`"
                 t-att-style="`transform: scale(${state.zoom}) translate(${state.panX}px, ${state.panY}px);`">
                
                <!-- Grid -->
                <PlanGrid t-if="state.showGrid"
                    show="state.showGrid"
                    size="state.gridSize"
                    color="props.data.settings.grid_color || '#E0E0E0'"
                    width="state.imageWidth"
                    height="state.imageHeight"/>
                
                <!-- Background Image -->
                <image t-if="state.imageLoaded"
                       t-ref="image"
                       t-att-href="`data:image/png;base64,${props.data.image}`"
                       t-att-width="state.imageWidth"
                       t-att-height="state.imageHeight"
                       x="0" y="0"/>
                
                <!-- Polygons -->
                <g class="o_plan_polygons">
                    <t t-foreach="state.polygons" t-as="polygon" t-key="polygon.id || polygon_index">
                        <polygon 
                            t-att-points="polygon.points.map(p => `${p[0]},${p[1]}`).join(' ')"
                            t-att-fill="polygon.fill_color"
                            t-att-stroke="polygon.stroke_color"
                            t-att-stroke-width="polygon.stroke_width"
                            t-att-opacity="polygon.opacity"
                            t-att-class="{'o_plan_polygon_selected': state.selectedPolygonId === polygon.id}"
                            t-on-click="() => this.selectPolygon(polygon.id)"/>
                        
                        <!-- Polygon Label (Area) -->
                        <text t-if="polygon.area_meters"
                              t-att-x="polygon.centroid_x"
                              t-att-y="polygon.centroid_y"
                              class="o_plan_polygon_label"
                              text-anchor="middle">
                            <t t-esc="polygon.area_meters.toFixed(2)"/> m²
                        </text>
                    </t>
                </g>
                
                <!-- New Polygon (being drawn) -->
                <g t-if="state.isDrawing" class="o_plan_new_polygon">
                    <polygon 
                        t-att-points="state.newPolygonPoints.map(p => `${p[0]},${p[1]}`).join(' ')"
                        fill="rgba(52, 152, 219, 0.3)"
                        stroke="#2980b9"
                        stroke-width="2"/>
                    <t t-foreach="state.newPolygonPoints" t-as="point" t-key="point_index">
                        <circle 
                            t-att-cx="point[0]"
                            t-att-cy="point[1]"
                            r="5"
                            fill="#fff"
                            stroke="#2980b9"
                            stroke-width="2"/>
                    </t>
                </g>
                
                <!-- Ruler -->
                <PlanRuler t-if="state.rulerPoints.length > 0"
                    points="state.rulerPoints"
                    distance="state.rulerDistance"
                    scaleCoefficient="props.data.scaleCoefficient"
                    color="props.data.settings.ruler_color || '#e67e22'"
                    width="props.data.settings.ruler_width || 3"/>
                
                <!-- Origin Point -->
                <g t-if="props.data.showOrigin" class="o_plan_origin">
                    <circle 
                        t-att-cx="props.data.originX"
                        t-att-cy="props.data.originY"
                        t-att-r="props.data.settings.origin_size || 8"
                        t-att-fill="props.data.settings.origin_color || '#e74c3c'"
                        stroke="#fff"
                        stroke-width="2"/>
                    <text 
                        t-att-x="props.data.originX + 15"
                        t-att-y="props.data.originY + 5"
                        class="o_plan_origin_label">0</text>
                </g>
            </svg>
        </div>
    </t>

    <!-- Toolbar Template -->
    <t t-name="yodoo_plan_view.Toolbar">
        <div class="o_plan_toolbar">
            <div class="btn-group">
                <button class="btn btn-sm" 
                        t-att-class="{'btn-primary': props.selectedTool === 'select', 'btn-secondary': props.selectedTool !== 'select'}"
                        t-on-click="() => this.selectTool('select')"
                        title="Select">
                    <i class="fa fa-mouse-pointer"/>
                </button>
                <button class="btn btn-sm"
                        t-att-class="{'btn-primary': props.selectedTool === 'draw', 'btn-secondary': props.selectedTool !== 'draw'}"
                        t-on-click="() => this.selectTool('draw')"
                        title="Draw Polygon">
                    <i class="fa fa-pencil"/>
                </button>
                <button class="btn btn-sm"
                        t-att-class="{'btn-primary': props.selectedTool === 'ruler', 'btn-secondary': props.selectedTool !== 'ruler'}"
                        t-on-click="() => this.selectTool('ruler')"
                        title="Measure">
                    <i class="fa fa-arrows-h"/>
                </button>
                <button class="btn btn-sm"
                        t-att-class="{'btn-primary': props.selectedTool === 'pan', 'btn-secondary': props.selectedTool !== 'pan'}"
                        t-on-click="() => this.selectTool('pan')"
                        title="Pan">
                    <i class="fa fa-hand-paper-o"/>
                </button>
            </div>
            <div class="btn-group ms-2">
                <button class="btn btn-sm btn-secondary" t-on-click="props.onToggleGrid" title="Toggle Grid">
                    <i class="fa fa-th"/>
                </button>
                <button class="btn btn-sm btn-secondary" t-on-click="props.onToggleSnap" title="Snap to Grid">
                    <i class="fa fa-magnet"/>
                </button>
            </div>
            <div class="btn-group ms-auto">
                <button class="btn btn-sm btn-success" t-on-click="props.onSave">
                    <i class="fa fa-save"/> Save
                </button>
                <button class="btn btn-sm btn-secondary" t-on-click="props.onCancel">
                    <i class="fa fa-times"/> Cancel
                </button>
            </div>
        </div>
    </t>

    <!-- Zoom Template -->
    <t t-name="yodoo_plan_view.Zoom">
        <div class="o_plan_zoom">
            <button class="btn btn-sm btn-light" t-on-click="props.onZoomIn" title="Zoom In">
                <i class="fa fa-plus"/>
            </button>
            <div class="o_plan_zoom_level">
                <t t-esc="zoomPercent"/>%
            </div>
            <button class="btn btn-sm btn-light" t-on-click="props.onZoomOut" title="Zoom Out">
                <i class="fa fa-minus"/>
            </button>
            <button class="btn btn-sm btn-light" t-on-click="props.onZoomReset" title="Reset Zoom">
                <i class="fa fa-crosshairs"/>
            </button>
        </div>
    </t>

    <!-- Grid Template -->
    <t t-name="yodoo_plan_view.Grid">
        <defs>
            <pattern t-att-id="patternId" 
                     t-att-width="props.size" 
                     t-att-height="props.size" 
                     patternUnits="userSpaceOnUse">
                <path t-att-d="`M ${props.size} 0 L 0 0 0 ${props.size}`" 
                      fill="none" 
                      t-att-stroke="props.color" 
                      stroke-width="1"/>
            </pattern>
        </defs>
        <rect t-att-width="props.width" 
              t-att-height="props.height" 
              t-att-fill="`url(#${patternId})`"/>
    </t>

    <!-- Ruler Template -->
    <t t-name="yodoo_plan_view.Ruler">
        <g class="o_plan_ruler" t-if="props.points.length === 2">
            <line 
                t-att-x1="props.points[0][0]"
                t-att-y1="props.points[0][1]"
                t-att-x2="props.points[1][0]"
                t-att-y2="props.points[1][1]"
                t-att-stroke="props.color"
                t-att-stroke-width="props.width"/>
            <circle t-att-cx="props.points[0][0]" t-att-cy="props.points[0][1]" r="5" t-att-fill="props.color"/>
            <circle t-att-cx="props.points[1][0]" t-att-cy="props.points[1][1]" r="5" t-att-fill="props.color"/>
            <text t-if="midPoint" 
                  t-att-x="midPoint[0]" 
                  t-att-y="midPoint[1] - 10"
                  class="o_plan_ruler_label"
                  text-anchor="middle">
                <t t-if="distanceInMeters" t-esc="distanceInMeters"/> m
                (<t t-esc="props.distance.toFixed(0)"/> px)
            </text>
        </g>
    </t>

</templates>
