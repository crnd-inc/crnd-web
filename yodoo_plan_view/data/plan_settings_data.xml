<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Default Plan Settings -->
        <record id="default_plan_settings" model="plan.settings">
            <field name="name">Default Settings</field>
            <field name="grid_enabled" eval="False"/>
            <field name="grid_size" eval="20"/>
            <field name="grid_color">#E0E0E0</field>
            <field name="grid_snap" eval="False"/>
            <field name="default_fill_color">#3498db</field>
            <field name="default_stroke_color">#2980b9</field>
            <field name="default_stroke_width" eval="2"/>
            <field name="default_opacity" eval="0.5"/>
            <field name="highlight_fill_color">#e74c3c</field>
            <field name="highlight_stroke_color">#c0392b</field>
            <field name="highlight_stroke_width" eval="3"/>
            <field name="point_radius" eval="5"/>
            <field name="point_color">#ffffff</field>
            <field name="point_stroke_color">#2c3e50</field>
            <field name="point_stroke_width" eval="2"/>
            <field name="ruler_color">#e67e22</field>
            <field name="ruler_width" eval="3"/>
            <field name="measurement_font_size" eval="14"/>
            <field name="measurement_color">#2c3e50</field>
            <field name="origin_color">#e74c3c</field>
            <field name="origin_size" eval="8"/>
            <field name="label_font_size" eval="12"/>
            <field name="label_font_family">Arial</field>
            <field name="label_color">#2c3e50</field>
            <field name="show_area_labels" eval="True"/>
        </record>
        
    </data>
</odoo>
