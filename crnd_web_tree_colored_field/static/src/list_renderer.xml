<?xml version="1.0" encoding="UTF-8"?>
<templates>

    <t t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='this.getColumns(record)']/t[@t-if=&quot;column.type === 'field'&quot;]/td" position="attributes">
            <attribute name="t-att-style">this.getCellColorStyle(column, record)</attribute>
        </xpath>
    </t>

</templates>
