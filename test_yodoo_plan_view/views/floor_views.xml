<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Floor Form View -->
    <record id="view_building_floor_form" model="ir.ui.view">
        <field name="name">building.floor.form</field>
        <field name="model">building.floor</field>
        <field name="arch" type="xml">
            <form string="Floor">
                <header>
                    <button name="action_open_plan" string="Open Plan" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rooms" type="object" class="oe_stat_button" icon="fa-door-open">
                            <field name="room_count" widget="statinfo" string="Rooms"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="building_name"/>
                            <field name="floor_number"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="total_area"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Plan" name="plan">
                            <group>
                                <group>
                                    <field name="plan_image" widget="image" class="oe_avatar"/>
                                    <field name="plan_image_type"/>
                                    <field name="plan_scale_coefficient"/>
                                </group>
                                <group>
                                    <field name="plan_show_grid"/>
                                    <field name="plan_grid_size"/>
                                    <field name="plan_snap_to_grid"/>
                                    <field name="plan_show_origin"/>
                                </group>
                            </group>
                        </page>
                        <page string="Rooms" name="rooms">
                            <field name="room_ids">
                                <list>
                                    <field name="room_number"/>
                                    <field name="name"/>
                                    <field name="room_type"/>
                                    <field name="area"/>
                                    <field name="capacity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Floor List View -->
    <record id="view_building_floor_list" model="ir.ui.view">
        <field name="name">building.floor.list</field>
        <field name="model">building.floor</field>
        <field name="arch" type="xml">
            <list string="Floors">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="building_name"/>
                <field name="floor_number"/>
                <field name="room_count"/>
                <field name="total_area"/>
                <button name="action_open_plan" string="Open Plan" type="object" icon="fa-map" class="btn-primary"/>
                <button name="action_view_rooms" string="Rooms" type="object" icon="fa-door-open"/>
            </list>
        </field>
    </record>
    
    <!-- Floor Plan View -->
    <record id="view_building_floor_plan" model="ir.ui.view">
        <field name="name">building.floor.plan</field>
        <field name="model">building.floor</field>
        <field name="arch" type="xml">
            <plan>
                <field name="plan_image"/>
                <field name="plan_scale_coefficient"/>
            </plan>
        </field>
    </record>
    
    <!-- Floor Action -->
    <record id="action_building_floor" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">building.floor</field>
        <field name="view_mode">list,form,plan</field>
    </record>
    
    <!-- Menu -->
    <menuitem id="menu_building_root"
              name="Yodoo Plan"
              sequence="50"/>
    
    <menuitem id="menu_building_floor"
              name="Floors"
              parent="menu_building_root"
              action="action_building_floor"
              sequence="10"/>
    
</odoo>
