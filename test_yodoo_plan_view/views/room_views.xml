<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Room Form View -->
    <record id="view_building_room_form" model="ir.ui.view">
        <field name="name">building.room.form</field>
        <field name="model">building.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <header>
                    <button name="action_open_on_plan" string="Show on Plan" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="room_number"/>
                            <field name="floor_id"/>
                        </group>
                        <group>
                            <field name="room_type"/>
                            <field name="area"/>
                            <field name="capacity"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Room List View -->
    <record id="view_building_room_list" model="ir.ui.view">
        <field name="name">building.room.list</field>
        <field name="model">building.room</field>
        <field name="arch" type="xml">
            <list string="Rooms">
                <field name="room_number"/>
                <field name="name"/>
                <field name="floor_id"/>
                <field name="room_type"/>
                <field name="area"/>
                <field name="capacity"/>
                <button name="action_open_on_plan" string="Show on Plan" type="object" icon="fa-map-marker" class="btn-primary"/>
            </list>
        </field>
    </record>
    
    <!-- Room Action -->
    <record id="action_building_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">building.room</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="menu_building_room"
              name="Rooms"
              parent="menu_building_root"
              action="action_building_room"
              sequence="20"/>
    
</odoo>
