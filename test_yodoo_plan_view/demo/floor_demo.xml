<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Demo Floor 1 -->
        <record id="floor_demo_1" model="building.floor">
            <field name="name">Ground Floor</field>
            <field name="building_name">Main Building</field>
            <field name="floor_number">0</field>
            <field name="sequence">10</field>
            <field name="plan_show_grid" eval="True"/>
            <field name="plan_grid_size" eval="20"/>
            <field name="plan_snap_to_grid" eval="True"/>
            <field name="plan_show_origin" eval="True"/>
            <field name="notes">Main entrance and reception area</field>
        </record>
        
        <!-- Demo Floor 2 -->
        <record id="floor_demo_2" model="building.floor">
            <field name="name">1st Floor</field>
            <field name="building_name">Main Building</field>
            <field name="floor_number">1</field>
            <field name="sequence">20</field>
            <field name="plan_show_grid" eval="True"/>
            <field name="plan_grid_size" eval="20"/>
            <field name="notes">Office spaces</field>
        </record>
        
        <!-- Demo Rooms for Floor 1 -->
        <record id="room_demo_101" model="building.room">
            <field name="name">Reception</field>
            <field name="room_number">101</field>
            <field name="floor_id" ref="floor_demo_1"/>
            <field name="room_type">other</field>
            <field name="area">25.0</field>
            <field name="capacity">5</field>
        </record>
        
        <record id="room_demo_102" model="building.room">
            <field name="name">Conference Room A</field>
            <field name="room_number">102</field>
            <field name="floor_id" ref="floor_demo_1"/>
            <field name="room_type">meeting</field>
            <field name="area">40.0</field>
            <field name="capacity">12</field>
        </record>
        
        <record id="room_demo_103" model="building.room">
            <field name="name">Kitchen</field>
            <field name="room_number">103</field>
            <field name="floor_id" ref="floor_demo_1"/>
            <field name="room_type">kitchen</field>
            <field name="area">15.0</field>
            <field name="capacity">8</field>
        </record>
        
        <!-- Demo Rooms for Floor 2 -->
        <record id="room_demo_201" model="building.room">
            <field name="name">Office 201</field>
            <field name="room_number">201</field>
            <field name="floor_id" ref="floor_demo_2"/>
            <field name="room_type">office</field>
            <field name="area">20.0</field>
            <field name="capacity">4</field>
        </record>
        
        <record id="room_demo_202" model="building.room">
            <field name="name">Office 202</field>
            <field name="room_number">202</field>
            <field name="floor_id" ref="floor_demo_2"/>
            <field name="room_type">office</field>
            <field name="area">20.0</field>
            <field name="capacity">4</field>
        </record>
        
    </data>
</odoo>
